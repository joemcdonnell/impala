# Broadcast join with a parallel build. Each host gets 3 build workers. The build fragment
# has 3 instances per host, each with a share of the hash table, and the sender routes the
# rows to the workers.
select count(*) from functional.alltypes a
join /* +broadcast */ functional.alltypessmall b on a.id = b.id
